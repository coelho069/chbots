{
  "name": "ch-bots",
  "productName": "CH BOTS",
  "version": "0.4.0",
  "description": "Agentes de IA locais que conversam e passam tarefas entre si.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postbuild": "node scripts/patch-bundle.cjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node tests/e2e/flows.e2e.mjs",
    "predist": "rimraf build-out",
    "dist": "electron-vite build && electron-builder --win",
    "postdist": "node -e \"const fs=require('fs'),p=require('path').resolve('build-out/CH-BOTS-Setup.exe'); if(!fs.existsSync(p)){console.error('ERRO: instalador nao encontrado: '+p); process.exit(1)} console.log(p)\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@rolldown/binding-wasm32-wasi": "^1.2.15",
    "node-cron": "4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@rollup/wasm-node": "^4.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.15",
    "typescript": "5.9.3",
    "vite": "^6.4.5",
    "vitest": "5.0.5"
  }
}
